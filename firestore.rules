rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents and subcollections
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // User settings
    match /settings/{userId} {
      allow read, write: if true;
    }

    // User presence
    match /presence/{userId} {
      allow read, write: if true;
    }

    // Chats and messaging
    match /chats/{chatId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Messages collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Posts and social feeds
    match /posts/{postId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Comments
    match /comments/{commentId} {
      allow read, write: if true;
    }

    // Likes
    match /likes/{likeId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Advertisements
    match /ads/{adId} {
      allow read, write: if true;
    }

    // Verification Requests
    match /verifications/{reqId} {
      allow read, write: if true;
    }

    match /verification_requests/{reqId} {
      allow read, write: if true;
    }

    // Safety Reports
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /logs/{logId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{testId} {
      allow read, write: if true;
    }

    // Fallback catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}



